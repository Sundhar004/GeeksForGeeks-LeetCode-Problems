#include <iostream>
#include <map>
#include <vector>

using namespace std;
int main()
{
    int n;
    cin>>n;
    vector<int>a;
    for(int i=0;i<n;i++)
    {
        int input;
        cin>>input;
        a.push_back(input);
    }
    map<int, int> map;
    for(int i:a)
    {
        map[i]++;
    }
    for(int i:a)
    {
        if(map[i] == 1)
        {
            cout<<i;
            return 0;
        }
    }
}
